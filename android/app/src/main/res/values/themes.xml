<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Universal" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryVariant">@color/teal_dark</item>
        <item name="colorOnPrimary">@color/on_teal</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorOnSecondary">@color/on_teal</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="android:textColorHint">@color/dim</item>
        <item name="colorControlNormal">@color/dim</item>
        <item name="colorControlActivated">@color/teal</item>
    </style>

    <style name="Theme.Universal.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <style name="Universal.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/teal</item>
        <item name="hintTextColor">@color/teal</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
