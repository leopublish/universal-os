#!/usr/bin/bash
# universal-welcome — first-login setup for Universal OS.
#   1. Sign in with Google (KDE Online Accounts: Google Drive in Files)
#   2. Extras: Google Play for Android apps, Claude Code in the terminal
# Runs automatically once per user; run `universal-welcome --force` to repeat.
set -uo pipefail

marker="${XDG_CONFIG_HOME:-$HOME/.config}/universal/welcome-done"
[ "${1:-}" = "--force" ] || [ ! -e "$marker" ] || exit 0
mkdir -p "$(dirname "$marker")"
T="Welcome to Universal OS"
finish() { touch "$marker"; exit 0; }
name=$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)

kdialog --title "$T" --yes-label "Continue" --no-label "Skip setup" --yesno \
"<h2>Welcome, ${name:-$USER}</h2>
<p>Your apps are ready in the launcher and dock:</p>
<p><b>AI:</b> Claude · ChatGPT · Gemini<br>
<b>Chat:</b> Telegram · WhatsApp · Messenger<br>
<b>Meta:</b> Instagram · Facebook · Threads<br>
<b>Google:</b> Chrome · Gmail · Drive · Calendar · Docs · YouTube · Maps · Meet</p>
<p>Let's connect your Google account. You can run this again from <b>Welcome</b> in the launcher.</p>" || finish

# --- 1. Google account --------------------------------------------------------
if kdialog --title "$T" --yes-label "Sign in with Google" --no-label "Not now" --yesno \
"<h3>Google account</h3>
<p>Sign in once to see <b>Google Drive</b> in the Files app (under <i>Network</i>).
For Gmail, YouTube and the other Google apps, you sign in inside Chrome the first time you open one.</p>
<p>In the window that opens, click <b>Add New Account…</b>, choose <b>Google</b>, and sign in.
Google's own page handles your password and 2-step verification.</p>"; then
    systemsettings kcm_kaccounts
fi

# --- 2. Extras ---------------------------------------------------------------------
choice=$(kdialog --title "$T" --separate-output --checklist \
"<h3>Extras</h3><p>Choose what to add:</p>" \
    playstore  "Google Play Store for Android apps (downloads about 1 GB)"   off \
    claudecode "Claude Code: Claude in the terminal (anthropic.com)"         off) || choice=""

steps=""
if grep -qx playstore <<<"$choice"; then
    steps+='universal-android-setup --gapps --no-wait; echo; '
fi
if grep -qx claudecode <<<"$choice"; then
    steps+='echo "== Installing Claude Code =="; curl -fsSL https://claude.ai/install.sh | bash && echo "Done. Open a terminal and type: claude"; echo; '
fi
if [ -n "$steps" ]; then
    konsole --hide-menubar -e bash -c "$steps"'read -rp "Press Enter to close…" _'
fi

if [ ! -e /var/lib/universal/apps-setup-done ]; then
    extra="<p><i>Chrome and Telegram are still downloading in the background. They appear in a few minutes.</i></p>"
fi
kdialog --title "$T" --msgbox \
"<h3>You're all set</h3>
<ul>
<li>Google Drive: <b>Files → Network → Google Drive</b></li>
<li>Android apps: double-click any <b>.apk</b>, or use the Play Store</li>
<li>Windows programs: double-click any <b>.exe</b></li>
</ul>${extra:-}"
finish
